{
  "schemaVersion": 1,
  "id": "io.github.cesarfilho.bluetooth-adapter-switch",
  "name": "Bluetooth Adapter Switch",
  "version": "1.2.0",
  "author": "cesarfilho",
  "license": "MIT",
  "description": "Keeps exactly one Bluetooth adapter active and switches automatically when a USB dongle is plugged in or out; a bar panel shows each adapter and lets you pick one.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Bluetooth Adapter Switch",
    "description": "Shows the active Bluetooth adapter and lets you switch between adapters from a panel.",
    "category": "Hardware",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "showLabel": true,
      "refreshIntervalSec": 10,
      "preferred": "USB dongle",
      "labelMode": "Type",
      "clickAction": "Open panel",
      "notify": true
    },
    "schema": [
      {
        "key": "showLabel",
        "type": "boolean",
        "label": "Show adapter name next to the icon",
        "defaultValue": true
      },
      {
        "key": "preferred",
        "type": "enum",
        "label": "Preferred adapter",
        "options": [
          "USB dongle",
          "Onboard"
        ],
        "defaultValue": "USB dongle",
        "description": "Which adapter is active when several are present, for example right after plugging in a dongle."
      },
      {
        "key": "labelMode",
        "type": "enum",
        "label": "Bar label",
        "options": [
          "Type",
          "Adapter id"
        ],
        "defaultValue": "Type",
        "description": "Type shows USB or Onboard; Adapter id shows hci0, hci1."
      },
      {
        "key": "clickAction",
        "type": "enum",
        "label": "Left click",
        "options": [
          "Open panel",
          "Switch to next"
        ],
        "defaultValue": "Open panel"
      },
      {
        "key": "notify",
        "type": "boolean",
        "label": "Notify after switching",
        "defaultValue": true
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 2,
        "max": 120,
        "step": 1,
        "defaultValue": 10
      }
    ]
  }
}
